const int melodyLength = sizeof(melody) / sizeof(melody[0]);

void setup() {
    pinMode(buttonPin, INPUT_PULLUP);
    pinMode(buzzerPin, OUTPUT);
    for (int i = 0; i < 6; i++) pinMode(ledPins[i], OUTPUT);
    motor.attach(motorPin);
    motor.write(90); // Stop motor initially
}

void loop() {
    checkButtonPress(); // Handles play/pause toggling of melody, motor, and LED blinking
    if (isPlaying) {
        playMelody(); // Play the melody when it's in "play" state
        controlMotor (); // Control motor when in "play" state
    } else {
        stopMotor(); // Stop motor when paused
        stopLEDs(); // Stop LEDs when paused
    }
    if (isPlaying) {
        blinkLEDs(); // LED blinking will continue when in "play" state
    }
}

void checkButtonPress() {
    if (digitalRead(buttonPin) == LOW && millis() - lastButtonPress > debounceTime) {
        isPlaying = !isPlaying; // Toggle play/pause for melody, motor, and LED blinking
        if (!isPlaying) {
            currentNoteIndex = 0; // Reset melody to start if paused
        }
        lastButtonPress = millis();
    }
}

void playMelody() {
    // Ensure the melody continues playing smoothly without any pauses
    if (currentNoteIndex >= melodyLength) {
        currentNoteIndex = 0; // Reset the melody index when it finishes
    }

    // Use millis to ensure there's no delay
    unsigned long currentMillis = millis();
    if (currentMillis - previousMillisNote >= noteDurations[currentNoteIndex]) {
        previousMillisNote = currentMillis; // Update previousMillisNote to the current time
        int note = melody[currentNoteIndex];
        if (note > 0) {
            tone(buzzerPin, note, noteDurations[currentNoteIndex]);
        }
        currentNoteIndex++; // Move to the next note
    }
}

void blinkLEDs() {
    unsigned long currentMillis = millis();
    long blinkInterval = 500; // Set LED blink interval (independent of melody)

    if (currentMillis - previousMillisLED >= blinkInterval) {
        previousMillisLED = currentMillis;
