#include <Servo.h>

// Define button, buzzer, servo, LED pins
const int buttonPin = 2;
const int resetButtonPin = 9;
const int buzzerPin = 8;
const int ledPin1 = 3;
const int ledPin2 = 4;
const int ledPin3 = 5;
const int ledPin4 = 6;
const int motorPin = 7;

Servo motor;

// Debounce & state variables
bool isPlaying = false;
int currentNoteIndex = 0;
unsigned long lastButtonPress = 0;
const int debounceTime = 600;

unsigned long previousMillisLED = 0;
const long blinkIntervalHigh = 100;
const long blinkIntervalLow = 300;
bool ledState = false;

unsigned long motorStartTime = 0;
const long motorInterval = 2000;
bool motorPosition = false;

// Melody repeat tracking
int melodyRepeatCount = 0;
const int totalMelodyRepeats = 3;
bool melodyFinished = false;

// Note frequencies
const int NOTE_G4 = 392;
const int NOTE_A4 = 440;
const int NOTE_B4 = 494;
const int NOTE_D4 = 294;
const int NOTE_E4 = 330;
const int REST = 0;

// Melody
int melody[] = {
  NOTE_G4, NOTE_G4, NOTE_G4, NOTE_D4, NOTE_E4, NOTE_E4, NOTE_D4,
  NOTE_B4, NOTE_B4, NOTE_A4, NOTE_A4, NOTE_G4, REST,
  NOTE_D4, NOTE_G4, NOTE_G4, NOTE_G4, NOTE_D4, NOTE_E4, NOTE_E4, NOTE_D4,
  NOTE_B4, NOTE_B4, NOTE_A4, NOTE_A4, NOTE_G4, REST,
  NOTE_D4, NOTE_D4, NOTE_G4, NOTE_G4, NOTE_G4, NOTE_D4, NOTE_D4, NOTE_G4, NOTE_G4, NOTE_G4,
  NOTE_G4, NOTE_G4, NOTE_G4, NOTE_G4, NOTE_G4, NOTE_G4,
  NOTE_G4, NOTE_G4, NOTE_G4, NOTE_G4, NOTE_G4, NOTE_G4,
  NOTE_G4, NOTE_G4, NOTE_G4, NOTE_D4, NOTE_E4, NOTE_E4, NOTE_D4,
  NOTE_B4, NOTE_B4, NOTE_A4, NOTE_A4, NOTE_G4,
};

int noteDurations[] = {
  250, 250, 250, 250, 250, 250, 500,
  250, 250, 250, 250, 500, 250,
  250, 250, 250, 250, 250, 250, 250, 500,
  250, 250, 250, 250, 500, 250,
  125, 125, 250, 250, 250, 125, 125, 250, 250, 500,
  125, 125, 250, 125, 125, 250,
  125, 125, 125, 125, 250, 250,
  250, 250, 250, 250, 250, 250, 500,
  250, 250, 250, 250, 500,
};

void setup() {
  pinMode(buttonPin, INPUT_PULLUP);
  pinMode(resetButtonPin, INPUT_PULLUP);
  pinMode(buzzerPin, OUTPUT);

  pinMode(ledPin1, OUTPUT);
  pinMode(ledPin2, OUTPUT);
  pinMode(ledPin3, OUTPUT);
  pinMode(ledPin4, OUTPUT);

  motor.attach(motorPin);
  motor.write(180);
}

void loop() {
  // Start/Stop button
  if (digitalRead(buttonPin) == LOW) {
    if (millis() - lastButtonPress > debounceTime) {
      isPlaying = !isPlaying;
      lastButtonPress = millis();
      delay(30);

      if (!isPlaying) {
        stopMotor();
        stopLEDs();
      }
    }
  }

  // Reset button
  if (digitalRead(resetButtonPin) == LOW) {
    if (millis() - lastButtonPress > debounceTime) {
      resetSystem();
      lastButtonPress = millis();
      delay(30);
    }
  }

  if (isPlaying) {
    playMelody();
    controlMotor();
  } else {
    stopLEDs();
  }
}

void playMelody() {
  if (melodyFinished) {
    isPlaying = false;
    stopMotor();
    stopLEDs();
    return;
  }

  if (currentNoteIndex < sizeof(melody) / sizeof(melody[0])) {
    int noteDuration = noteDurations[currentNoteIndex];
    tone(buzzerPin, melody[currentNoteIndex], noteDuration);

    if (melody[currentNoteIndex] > 440) {
      blinkLEDs(blinkIntervalHigh);
    } else {
      blinkLEDs(blinkIntervalLow);
    }

    delay(noteDuration);
    currentNoteIndex++;
  } else {
    melodyRepeatCount++;
    if (melodyRepeatCount >= totalMelodyRepeats) {
      melodyFinished = true;
    } else {
      currentNoteIndex = 0;
    }
  }
}

void controlMotor() {
  unsigned long currentMillis = millis();
  if (currentMillis - motorStartTime >= motorInterval) {
    motorStartTime = currentMillis;
    motorPosition = !motorPosition;
    motor.write(motorPosition ? 180 : 120);
  }
}

void blinkLEDs(long interval) {
  unsigned long currentMillis = millis();
  if (currentMillis - previousMillisLED >= interval) {
    previousMillisLED = currentMillis;
    ledState = !ledState;

    digitalWrite(ledPin1, ledState ? HIGH : LOW);
    digitalWrite(ledPin2, ledState ? HIGH : LOW);
    digitalWrite(ledPin3, ledState ? HIGH : LOW);
    digitalWrite(ledPin4, ledState ? HIGH : LOW);
  }
}

void stopLEDs() {
  digitalWrite(ledPin1, LOW);
  digitalWrite(ledPin2, LOW);
  digitalWrite(ledPin3, LOW);
  digitalWrite(ledPin4, LOW);
}

void stopMotor() {
  motor.write(180);
}

void resetSystem() {
  currentNoteIndex = 0;
  melodyRepeatCount = 0;
  melodyFinished = false;
  isPlaying = false;
  stopMotor();
  stopLEDs();
}
